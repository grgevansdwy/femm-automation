From 21762b3039b0a1f428267d96f79d97ee02e512a8 Mon Sep 17 00:00:00 2001
From: Genki Marshall <genki.marshall@vendor.com>
Date: Wed, 13 Nov 2024 09:38:05 -0800
Subject: [PATCH] Add 'force' parameter for uploading/updating firmware

---
 python/vendor/interface/vendorsocket.py | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/python/vendor/interface/vendorsocket.py b/python/vendor/interface/vendorsocket.py
index 110ebe1..3af81a1 100755
--- a/python/vendor/interface/vendorsocket.py
+++ b/python/vendor/interface/vendorsocket.py
@@ -926,6 +926,7 @@ class VendorHTTP:
         self,
         file: Union[AnyStr, os.PathLike, IO[bytes]],
         progress_callback: Optional[Callable[[float], None]] = None,
+        force=False,
     ) -> None:
         """Upload firmware to the Vendor TR
         Optionally, progress_callback is called and passed a percent to completion"""
@@ -934,7 +935,7 @@ class VendorHTTP:
             file, wpt.DeviceID.TX
         )
         log.info(f"Stored Firmware version: {ota_firmware.tx_fw_name}")
-        if ota_firmware.tx_build_hash == (target_fw_hash >> 128):
+        if (not force) and (ota_firmware.tx_build_hash == (target_fw_hash >> 128)):
             return
         log.info("Uploading Firmware...")
         with ZipFile(file) as archive:
@@ -994,6 +995,7 @@ class VendorHTTP:
         device_id: wpt.DeviceID,
         firmware_path: Union[AnyStr, os.PathLike],
         progress_callback: Optional[Callable[[float], None]] = None,
+        force=False,
     ) -> None:
         """Upload firmware to the Vendor TR and update device to uploaded version
         Optionally, progress_callback is called and passed a percent to completion"""
@@ -1002,8 +1004,8 @@ class VendorHTTP:
             firmware_path, device_id
         )
         log.info(f"Current Firmware on {device_id.name}: {dev_fw_name}")
-        if dev_fw_hash != (target_fw_hash >> 128):
+        if force or (dev_fw_hash != (target_fw_hash >> 128)):
             log.info("Uploading Firmware...")
-            self.upload_firmware(firmware_path, progress_callback)
-            self.ws.update_using_loaded_firmware(device_id, progress_callback)
+            self.upload_firmware(firmware_path, progress_callback, force=force)
+            self.ws.update_using_loaded_firmware(device_id, progress_callback, force=force)
         log.info("Device firmware is up to date")
-- 
2.39.2


# Python
__pycache__/
*.py[cod]
.venv/
venv/

# FEMM scratch written to the repo root by a run.
# Real saved models under Branches_and_one_offs/ are NOT ignored - they are
# tracked on purpose so deleting them stays undoable.
tmp.fem
tmp.ans

# HelloImGui window-layout state written by desktop_app on launch.
FEMM_Coil_Automation.ini

# Generated run output - one flat JSON file per run, regenerable, not source.
coil_simulation/data/results/*.json

# LTspice byproducts
*.raw
*.net
*.fft
*.plt

# xfemm research spike - throwaway binaries/artifacts, not project source.
xfemm_spike/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# FEMM scratch written to the repo root by a run.
# Real saved models under Branches_and_one_offs/ are NOT ignored - they are
# tracked on purpose so deleting them stays undoable.
tmp.fem
tmp.ans

# HelloImGui window-layout state written by desktop_app on launch.
FEMM_Coil_Automation.ini

# SQLite config/result store - all configs and runs, generated locally, not
# checked in (binary, not diff-friendly). A fresh checkout gets the
# reference designs from backend/data/starter_configs/ on first launch; Backup All /
# Restore All (frontend/src/frontend/files_backup/backup_io.py) moves data between machines.
backend/data/femm_automation.db
backend/data/femm_automation.db-wal
backend/data/femm_automation.db-shm

# LTspice byproducts
*.raw
*.net
*.fft
*.plt


# .fem/.lua models written by the "Open in FEMM" button
# (backend/engine/services/femm_launcher.py) - regenerated from the config
# on every click, and a solve done by hand in FEMM drops a multi-MB .ans
# next to them.
backend/data/femm_models/

# Search benchmark working copy: database copy, results and full AI request logs
# (backend/agent/benchmark.py). The summary is docs/summarize_result.md.
backend/data/benchmark/

# Per-run AI request logs (backend/agent/services/run_log.py): full prompts and replies,
# a developer tool the app never reads.
backend/data/agent_logs/

# Copies of the database made before a schema migration or the one-time cleanup
# (agent/repositories/ai_run_repository.py, agent/cleanup_runs.py).
backend/data/backups/
